/imgui.ini
/tsm.log
/loudness_cache.json
/playlists.json
/playlist_single.json

# Locally supplied media
/assets/**/*.mp3
/assets/**/*.mp4
/assets/**/*.srt
/assets/**/*.wav

# Operating-system metadata
.DS_Store
Thumbs.db
