# The only supported, disposable build tree
/build/

# Local CMake and IDE state
CMakeUserPresets.json
/.vs/
__pycache__/
*.py[cod]

# Proprietary SDK (see the tracked instructions)
/external/*
!/external/README.md

# Legacy/accidental runtime state (current builds use user-local app data)
/imgui.ini
/tsm.log
/loudness_cache.json
/playback_state.json
/safety_state.json
/playlists.json
/playlist_single.json

# Locally supplied media
/assets/**/*.mp3
/assets/**/*.mp4
/assets/**/*.srt
/assets/**/*.wav

# Operating-system metadata
.DS_Store
Thumbs.db
