{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Windows x64",
      "description": "Production-grade Visual Studio 2022 configuration",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install",
        "TSM_WARNINGS_AS_ERRORS": "ON",
        "TSM_INSTALL_ASSETS": "OFF"
      },
      "warnings": {
        "deprecated": false,
        "dev": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "install-release",
      "configurePreset": "default",
      "configuration": "Release",
      "targets": ["install"]
    },
    {
      "name": "package-release",
      "configurePreset": "default",
      "configuration": "Release",
      "targets": ["package"]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "validate",
      "displayName": "Build, test, install and package Debug + Release",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" },
        { "type": "build", "name": "install-release" },
        { "type": "build", "name": "package-release" }
      ]
    }
  ]
}
